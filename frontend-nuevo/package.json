{
  "name": "lyfta-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lyfta: entrenamiento de fuerza, actividades y análisis.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "contrast": "node scripts/check-contrast.mjs",
    "scale": "node scripts/check-scale.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "smoke": "node scripts/smoke-browser.mjs",
    "visual": "node scripts/visual-regression.mjs",
    "check": "npm run tokens:check && npm run contrast && npm run scale && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.3",
    "lucide-react": "^0.548.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
