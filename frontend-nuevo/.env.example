# La API se resuelve por defecto en el mismo origen (`/api/v1`): en desarrollo
# el proxy de Vite la manda al backend. Deja VITE_API_URL vacía salvo que la API
# viva en otro origen.
# VITE_API_URL=

# Destino del proxy de desarrollo (no se usa en el bundle del cliente).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Bandera de las secciones ampliadas (Actividades, Calendario, Tendencias,
# Rendimiento, Rutas, Social). Por defecto, apagada; también se enciende desde
# Ajustes sin recompilar.
VITE_FEATURE_EXTENDED=false
