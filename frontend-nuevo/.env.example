# URL del backend FastAPI. En desarrollo, el proxy de Vite reenvía /api aquí.
# No hay secretos en este fichero: solo la dirección de la API.
VITE_API_URL=http://127.0.0.1:8000

# Bandera de las secciones ampliadas (Actividades, Calendario, Tendencias,
# Rendimiento, Rutas, Social, Marcas...). Por defecto, apagada.
VITE_FEATURE_EXTENDED=false
