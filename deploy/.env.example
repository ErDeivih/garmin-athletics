# Plantilla de `deploy/.env` (copiar como `.env`, nunca al repositorio).
#
# Este fichero hace dos cosas a la vez:
#  - Compose lee LYFTA_BIND y LYFTA_PORT para interpolar el mapeo de puertos.
#  - El contenedor recibe el resto como variables de entorno (y ganan sobre
#    cualquier `.env` que hubiera dentro de la imagen).

# IP del servidor en la red de casa: abre la app en el móvil sin Tailscale.
LYFTA_LAN_BIND=192.168.1.139
# IP del servidor en el tailnet: abre la app desde cualquier sitio.
LYFTA_TS_BIND=100.117.58.93
# Alternativa menos privada: usar 0.0.0.0 en las dos (escucha en todas las IP).
LYFTA_PORT=8010

# Firma de los tokens de sesión. Si cambia, todos los móviles tienen que volver
# a entrar (la sesión dura 30 días).
SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria

# Cuenta de Garmin (la vinculación real se guarda cifrada en la base de datos;
# estas dos solo hacen falta para el primer acceso o para los scripts).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Opcional: orígenes extra para CORS (coma separada). Con un único origen, vacío.
ALLOWED_ORIGINS=

# Opcional: clave de LLM si se usan las funciones que la necesitan.
LLM_API_KEY=
