# Configuración de Credenciales de Garmin Connect
GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_contraseña_garmin

# Configuración de Servidor y API
PROJECT_NAME="Garmin Athletics API"
DATABASE_URL="sqlite+aiosqlite:///./garmin_athletics.db"

# IA Engine (DeepSeek V4 Flash / Claude / OpenAI API Key)
LLM_API_KEY=tu_api_key_de_deepseek_o_claude

# Auth multiusuario (cámbiala en producción: clave para firmar tokens)
SECRET_KEY=dev-secret-change-me
