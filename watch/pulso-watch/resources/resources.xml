<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
  <strings>
    <string id="AppName">PULSO</string>
    <string id="ApiTitle">Conexión</string>
    <string id="TokenTitle">Acceso</string>
  </strings>
  <properties>
    <property id="apiUrl" type="string"></property>
    <property id="token" type="string"></property>
  </properties>
  <settings>
    <setting propertyKey="@Properties.apiUrl" title="@Strings.ApiTitle">
      <settingConfig type="alphaNumeric" />
    </setting>
    <setting propertyKey="@Properties.token" title="@Strings.TokenTitle">
      <settingConfig type="alphaNumeric" />
    </setting>
  </settings>
  <bitmap id="LauncherIcon" filename="images/launcher_icon.png" />
</resources>
